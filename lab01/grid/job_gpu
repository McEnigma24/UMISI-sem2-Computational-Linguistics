#!/bin/bash
#SBATCH --job-name=lab01_gpu
#SBATCH --account=plgar2026-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --gres=gpu:1
#SBATCH --time=03:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --output=output/out.txt
#SBATCH --error=output/err.txt

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

GPUS="${GPUS:-${SLURM_GPUS_ON_NODE:-1}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${SLURM_CPUS_PER_TASK:-4}}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

echo "GPUS=${GPUS} LAB01_SHELL_CMD=${LAB01_SHELL_CMD:-<default>}"

module load cuda
nvidia-smi

echo "GRID_JOB -> STARTED"
if [[ -n "${LAB01_SHELL_CMD:-}" ]]; then
  bash -lc "${LAB01_SHELL_CMD}"
elif [[ -n "${LAB01_CMD:-}" ]]; then
  # shellcheck disable=SC2086
  uv run lab01 ${LAB01_CMD}
else
  uv run lab01 all
fi
echo "GRID_JOB -> ENDED"
