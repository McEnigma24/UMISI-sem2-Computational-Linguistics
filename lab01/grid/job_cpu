#!/bin/bash
#SBATCH --job-name=GRID_TEMPLATE
#SBATCH --account=plgar2026-cpu     # hpc-grants -> Allocation:
#SBATCH --partition=cpu-lowprio     # sinfo -s   -> Partition:   cpu | cpu-lowprio | plgrid
#SBATCH --time=00:10:00
#SBATCH --ntasks=8                  # num of processes
#SBATCH --cpus-per-task=1           # threads per 1 process
#SBATCH --mem=16G
#SBATCH --output=output/out.txt
#SBATCH --error=output/err.txt

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh
ls -al

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${SLURM_CPUS_PER_TASK:-1}}"

module load openmpi/4.1.6-gcc-13.2.0

echo "SLURM_NTASKS=${SLURM_NTASKS} SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK} OMP_NUM_THREADS=${OMP_NUM_THREADS}"

# SCRATCH env activate #
# scratch_activation_path="$(realpath .)/.venv/bin/activate"
# echo "SOURCING -> $scratch_activation_path"
# source $scratch_activation_path



# START #
echo "GRID_JOB -> STARTED"

    if [[ "${SLURM_NTASKS:-1}" -gt 1 ]]; then
        mpirun -np "$SLURM_NTASKS" uv run python -m lab01_tokenization
    else
        uv run python -m lab01_tokenization
    fi


echo "GRID_JOB -> ENDED"
