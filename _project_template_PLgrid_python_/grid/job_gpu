#!/bin/bash
#SBATCH --job-name=PLGRID_TEMPLATE_GPU
#SBATCH --account=plgar2026-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --output=output/out.txt
#SBATCH --error=output/err.txt

set -euo pipefail

cd "$SLURM_SUBMIT_DIR"
# shellcheck source=/dev/null
[[ -f local/env.sh ]] && source local/env.sh

GPUS="${GPUS:-${SLURM_GPUS_ON_NODE:-1}}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-${SLURM_CPUS_PER_TASK:-4}}"

echo "GPUS=${GPUS} SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK} OMP_NUM_THREADS=${OMP_NUM_THREADS}"

module load cuda
nvidia-smi

echo "GRID_JOB -> STARTED"

if [[ "$GPUS" -gt 1 ]] && uv run python -c "import torch" 2>/dev/null; then
    uv run python -m torch.distributed.run --standalone --nproc_per_node="$GPUS" -m plgrid_lab
else
    if [[ "$GPUS" -gt 1 ]]; then
        echo "UWAGA: GPUS=$GPUS, ale brak PyTorch — jeden proces."
    fi
    uv run python -m plgrid_lab
fi

echo "GRID_JOB -> ENDED"
